{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Novel Engine",
  "version": "0.1.0",
  "identifier": "com.wangxingchao.novel",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Novel Engine",
        "width": 420,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}