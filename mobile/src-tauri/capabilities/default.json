{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "手机端权限：文件选择（导入电脑端导出的项目 JSON）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "/storage/**" },
        { "path": "/sdcard/**" }
      ]
    }
  ]
}
